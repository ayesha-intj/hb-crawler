CONTACT_EMAIL=ayesha24442@gmail.com
# Optional. Relative SQLite paths are resolved from the backend folder, so this
# always means backend/data/hb_crawler.db. Leave it out to use that default.
DATABASE_URL=sqlite:///./data/hb_crawler.db
# Origins allowed to call the API from a browser (the Next.js dev server).
CORS_ORIGINS=http://localhost:3000
# Politeness and scope of one crawl run.
CRAWL_DELAY_SECONDS=10
MAX_LISTING_PAGES=3
MAX_NEW_JOBS=50
# Delete jobs not seen for this many days.
JOB_RETENTION_DAYS=30
# Optional fallback if the website answers 403/429: the official, free API.
# Create a key at https://startup.jobs/account/api_keys (leave empty to disable).
STARTUP_JOBS_API_KEY=sj_STo7G7yxmfaXmy9YzPEGyjdU
API_MAX_PAGES=4
